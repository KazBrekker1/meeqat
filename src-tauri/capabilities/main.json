{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window on desktop. Only what app/ calls: add a permission here when the frontend starts using a new Tauri API.",
  "platforms": ["linux", "macOS", "windows"],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:resources:default",
    "core:tray:allow-get-by-id",
    "core:tray:allow-set-title",
    "notification:default",
    "store:default",
    "os:default",
    "prayer-service:default",
    "updater:default",
    "process:allow-restart",
    "opener:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "webcal:*" }
      ]
    }
  ]
}
