<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Re-arm the widget's update alarms after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Exact alarm at each prayer time, so the widget flips to the next prayer on time -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Permission for in-app APK updates (download + install the new release) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Boot Receiver: re-arm widget updates after reboot, redraw on clock/timezone changes -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Prayer Widget Provider -->
        <receiver
            android:name=".PrayerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.meeqat.plugin.prayerservice.WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_widget_info" />
        </receiver>

        <!-- Widget Update Receiver - prayer-boundary + periodic redraw alarms -->
        <receiver
            android:name=".WidgetUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.meeqat.plugin.prayerservice.UPDATE_WIDGET" />
                <action android:name="com.meeqat.plugin.prayerservice.PERIODIC_UPDATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
